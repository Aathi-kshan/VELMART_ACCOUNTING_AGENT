# Velmart API — environment variables (plan section 23.5)
#
# Copy to .env for local development. NEVER commit real values: secrets live only
# in Railway variables. This file documents names, not values.
#
# In development, only DATABASE_URL and JWT_SECRET_KEY are required.
# With ENVIRONMENT=production, every variable below marked (prod) must be set or
# the container refuses to boot.

ENVIRONMENT=development
LOG_LEVEL=INFO

# --- database ---------------------------------------------------------------
# The asyncpg driver is appended automatically by config.to_asyncpg_url().
DATABASE_URL=postgresql://velmart:velmart@localhost:5432/velmart
# (prod) the read-only role used by the AI read path
DATABASE_URL_READONLY=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_STATEMENT_TIMEOUT_MS=15000
AI_DB_STATEMENT_TIMEOUT_MS=8000

# --- object storage (prod) --------------------------------------------------
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# --- auth -------------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-64-byte-random-value-before-any-real-use
JWT_ALGORITHM=HS512
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# --- AI (prod) --------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL_ROUTER=
AI_MODEL_DEFAULT=
AI_MODEL_ANALYSIS=
AI_MAX_TOOL_CALLS=8
AI_TIMEOUT_SECONDS=12
AI_DAILY_USD_CAP_DEFAULT=3.00

# --- observability and limits -----------------------------------------------
SENTRY_DSN=
MAX_UPLOAD_MB=10
MAX_CSV_MB=10
MAX_PAGES_PER_COMPANY=100
MAX_COLUMNS_PER_PAGE=60
RATE_LIMIT_PER_MINUTE=100
